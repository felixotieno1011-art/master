#!/bin/bash

FILE="SPECIALIZATION.md"

if [ ! -f "$FILE" ]; then
    echo "❌ Error: $FILE not found. Are you in ~/master?"
    exit 1
fi

case "$1" in
    tick)
        if [ -z "$2" ]; then echo "Usage: spec tick <item> (e.g., spec tick B1)"; exit 1; fi
        sed -i "s/- \[ \] \(.*$2.*\)/- [x] \1/" "$FILE"
        echo "✅ Ticked: $2"
        ;;
    untick)
        if [ -z "$2" ]; then echo "Usage: spec untick <item>"; exit 1; fi
        sed -i "s/- \[x\] \(.*$2.*\)/- [ ] \1/" "$FILE"
        echo "🔲 Unticked: $2"
        ;;
    show)
        echo "🎯 SPECIALIZATION PROGRESS:"
        echo "-------------------------"
        DONE=$(grep -cE "^- \[x\]" "$FILE")
        TODO=$(grep -cE "^- \[ \]" "$FILE")
        echo "✅ Done: $DONE"
        echo "🔲 Todo: $TODO"
        echo "-------------------------"
        echo "Next up:"
        grep -E "^- \[ \]" "$FILE" | head -n 1
        ;;
    percent)
        TOTAL=$(grep -cE "^- \[( |x)\]" "$FILE")
        DONE=$(grep -cE "^- \[x\]" "$FILE")
        if [ "$TOTAL" -eq 0 ]; then echo "0%"; exit 0; fi
        PERCENT=$(( DONE * 100 / TOTAL ))
        echo "📊 Progress: $PERCENT% ($DONE/$TOTAL items)"
        ;;
    *)
        echo "Usage: spec {tick|untick|show|percent} <item>"
        echo "Example: spec tick B1"
        ;;
esac
