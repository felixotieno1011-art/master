#!/data/data/com.termux/files/usr/bin/bash
# aws — MiniAWS wrapper with real AWS syntax.

cd /data/data/com.termux/files/home/master/PRACTICALS/02-networking/miniaws

SERVICE="$1"
ACTION="$2"
shift 2 2>/dev/null

case "$SERVICE" in
  ec2)
    case "$ACTION" in
      describe-vpcs)               python vpc_cli.py describe-vpcs "$@" ;;
      create-vpc)                  python vpc_cli.py create-vpc "$@" ;;
      delete-vpc)                  python vpc_cli.py delete-vpc "$@" ;;
      describe-subnets)            python vpc_cli.py describe-subnets "$@" ;;
      create-subnet)               python vpc_cli.py create-subnet "$@" ;;
      delete-subnet)               python vpc_cli.py delete-subnet "$@" ;;
      describe-internet-gateways)  python vpc_cli.py describe-internet-gateways "$@" ;;
      create-internet-gateway)     python vpc_cli.py create-internet-gateway "$@" ;;
      attach-internet-gateway)     python vpc_cli.py attach-internet-gateway "$@" ;;
      detach-internet-gateway)     python vpc_cli.py detach-internet-gateway "$@" ;;
      delete-internet-gateway)     python vpc_cli.py delete-internet-gateway "$@" ;;
      describe-route-tables)       python vpc_cli.py describe-route-tables "$@" ;;
      add-internet-route)          python vpc_cli.py add-internet-route "$@" ;;
      associate-subnet)            python vpc_cli.py associate-subnet "$@" ;;
      run-instances)               python cli.py ec2 run-instances "$@" ;;
      describe-instances)          python cli.py ec2 describe-instances "$@" ;;
      describe-instance)           python cli.py ec2 describe-instance "$@" ;;
      start-instances)             python cli.py ec2 start-instances "$@" ;;
      stop-instances)              python cli.py ec2 stop-instances "$@" ;;
      reboot-instances)            python cli.py ec2 reboot-instances "$@" ;;
      terminate-instances)         python cli.py ec2 terminate-instances "$@" ;;
      *)
        echo "❌ aws ec2: unknown command: $ACTION"
        exit 1
        ;;
    esac
    ;;
  s3)
    case "$ACTION" in
      mb)   python cli.py s3 mb "$@" ;;
      ls)   python cli.py s3 ls "$@" ;;
      cp)   python cli.py s3 cp "$@" ;;
      rm)   python cli.py s3 rm "$@" ;;
      rb)   python cli.py s3 rb "$@" ;;
      *) echo "❌ aws s3: unknown: $ACTION"; exit 1 ;;
    esac
    ;;
  iam)              python iam_cli.py "$ACTION" "$@" ;;
  cloudwatch)       python cw_cli.py "$ACTION" "$@" ;;
  cloudformation)   python cfn_cli.py "$ACTION" "$@" ;;
  sts)
    case "$ACTION" in
      get-caller-identity)  python cli.py account show ;;
      *) echo "❌ aws sts: unknown: $ACTION"; exit 1 ;;
    esac
    ;;
  configure)        python cli.py account init "$@" ;;
  *)
    echo "❌ aws: unknown service: $SERVICE"
    exit 1
    ;;
esac
