#!/usr/bin/env python3
"""MiniAzure CLI — group, vm, storage, network, iam."""
import json
import os
import sys

import utils
from core import resource_group as rg
from core import vm as vmm
from core import storage
from core import network as netw
from core import iam


USAGE = """
miniazure — a tiny local version of Azure's CLI

USAGE:
  miniazure <command> <subcommand> [options]

IAM COMMANDS:
  login <username>
  logout
  whoami
  user create <username> [--role reader|contributor|admin]
  user list
  user delete <username>
  user role <username> <role>
  audit [--limit N]

GROUP COMMANDS:
  group create <name> [--region <r>] [--tags k=v,k=v]
  group list
  group show <name>
  group delete <name>

VM COMMANDS:
  vm create <name> --group <g> [--size small|medium|large]
  vm list [--group <g>]
  vm show <name>
  vm start <name>
  vm stop <name>
  vm restart <name>
  vm delete <name>
  vm stats <name>
  vm logs <name>
  vm attach <name> --vnet <v> --subnet <s>
  vm detach <name> --vnet <v> --subnet <s>

STORAGE COMMANDS:
  storage create <acct> --group <g> [--region <r>]
  storage list
  storage show <acct>
  storage delete <acct>
  storage container create <acct> <cont>
  storage container list <acct>
  storage container delete <acct> <cont>
  storage upload <acct> <cont> <file> [--as <blob>]
  storage blob list <acct> <cont>
  storage blob delete <acct> <cont> <blob>

NETWORK COMMANDS:
  network vnet create <name> --group <g> --cidr <c>
  network vnet list
  network vnet show <name>
  network vnet delete <name>
  network subnet create <vnet> <name> --cidr <c>
  network subnet list <vnet>
  network subnet delete <vnet> <name>
  network topology

BLOB SERVER:
  python -m core.blob_server

FIRST TIME:
  Default admin user is created automatically.
  Run: miniazure login admin
"""


def parse_flags(args):
    flags = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            if "=" in a:
                k, v = a[2:].split("=", 1)
                flags[k] = v
            else:
                k = a[2:]
                if i + 1 < len(args) and not args[i + 1].startswith("--"):
                    flags[k] = args[i + 1]
                    i += 1
                else:
                    flags[k] = True
        i += 1
    return flags


def print_row(cells, widths):
    print(" ".join(str(c).ljust(w) for c, w in zip(cells, widths)))


def require(action, detail=""):
    """
    Check permission for an action.
    Returns True if allowed. Prints error and audits if not.
    """
    allowed, reason = iam.can(action)
    if not allowed:
        print(utils.err(reason))
        iam.audit(action, detail, success=False)
        return False
    return True


def audit_ok(action, detail=""):
    iam.audit(action, detail, success=True)


# ---------- IAM ----------

def cmd_login(args):
    if not args:
        print(utils.err("usage: login <username>"))
        return 1
    ok_, msg = iam.login(args[0])
    print(utils.ok(msg) if ok_ else utils.err(msg))
    return 0 if ok_ else 1


def cmd_logout(args):
    ok_, msg = iam.logout()
    print(utils.ok(msg) if ok_ else utils.err(msg))
    return 0


def cmd_whoami(args):
    user = iam.get_current_user()
    if not user:
        print(utils.warn("not logged in"))
        return 0
    data = iam.get_user(user) or {}
    print(f"👤 {user}   role: {data.get('role','?')}")
    return 0


def cmd_user(args):
    if not args:
        print(USAGE); return 1
    sub, rest = args[0], args[1:]

    if sub == "create":
        if not rest:
            print(utils.err("username required")); return 1
        if not require("user.create"):
            return 1
        username = rest[0]
        flags = parse_flags(rest[1:])
        role = flags.get("role") or "reader"
        ok_, msg = iam.create_user(username, role)
        print(utils.ok(msg) if ok_ else utils.err(msg))
        audit_ok("user.create", f"{username}/{role}") if ok_ else None
        return 0 if ok_ else 1

    if sub == "list":
        if not require("user.list"): return 1
        users = iam.list_users()
        if not users:
            print(utils.warn("no users")); return 0
        print_row(["NAME", "ROLE", "CREATED"], [20, 14, 20])
        print("-" * 56)
        for u in users:
            print_row([u["name"], u["role"], u["created"]], [20, 14, 20])
        return 0

    if sub == "delete":
        if not rest:
            print(utils.err("username required")); return 1
        if not require("user.delete"): return 1
        ok_, msg = iam.delete_user(rest[0])
        print(utils.ok(msg) if ok_ else utils.err(msg))
        if ok_: audit_ok("user.delete", rest[0])
        return 0 if ok_ else 1

    if sub == "role":
        if len(rest) < 2:
            print(utils.err("usage: user role <username> <role>")); return 1
        if not require("user.role"): return 1
        ok_, msg = iam.set_role(rest[0], rest[1])
        print(utils.ok(msg) if ok_ else utils.err(msg))
        if ok_: audit_ok("user.role", f"{rest[0]}->{rest[1]}")
        return 0 if ok_ else 1

    print(utils.err(f"unknown user subcommand: {sub}")); return 1


def cmd_audit(args):
    flags = parse_flags(args)
    limit = int(flags.get("limit", 30)) if isinstance(flags.get("limit"), str) else 30
    lines = iam.read_audit(limit)
    if not lines:
        print(utils.warn("(no audit entries)")); return 0
    print(f"Last {len(lines)} audit entries:")
    print("-" * 70)
    for l in lines:
        print(l)
    return 0


# ---------- GROUP ----------

def cmd_group(args):
    if not args:
        print(USAGE); return 1
    sub, rest = args[0], args[1:]

    if sub == "create":
        if not rest:
            print(utils.err("name required")); return 1
        if not require("group.create", rest[0]): return 1
        name = rest[0]
        flags = parse_flags(rest[1:])
        tags = {}
        if "tags" in flags and isinstance(flags["tags"], str):
            for pair in flags["tags"].split(","):
                if "=" in pair:
                    k, v = pair.split("=", 1)
                    tags[k.strip()] = v.strip()
        ok_, msg = rg.create(name, region=flags.get("region"), tags=tags)
        print(utils.ok(msg) if ok_ else utils.err(msg))
        if ok_: audit_ok("group.create", name)
        return 0 if ok_ else 1

    if sub == "list":
        if not require("group.list"): return 1
        groups = rg.list_all()
        if not groups:
            print(utils.warn("no resource groups")); return 0
        print_row(["NAME", "REGION", "CREATED"], [20, 15, 20])
        print("-" * 58)
        for g in groups:
            print_row([g["name"], g["location"], g["created"]], [20, 15, 20])
        return 0

    if sub == "show":
        if not rest:
            print(utils.err("name required")); return 1
        if not require("group.show", rest[0]): return 1
        data = rg.get(rest[0])
        if not data:
            print(utils.err(f"resource group '{rest[0]}' not found")); return 1
        print(json.dumps(data, indent=2)); return 0

    if sub == "delete":
        if not rest:
            print(utils.err("name required")); return 1
        if not require("group.delete", rest[0]): return 1
        ok_, msg = rg.delete(rest[0])
        print(utils.ok(msg) if ok_ else utils.err(msg))
        if ok_: audit_ok("group.delete", rest[0])
        return 0 if ok_ else 1

    print(utils.err(f"unknown group subcommand: {sub}")); return 1
